}

// Carga una factura incluyendo las columnas con select:false que se necesiten.
// Por defecto trae dian_response. Pasar extra_cols para los blobs adicionales.
async function findInvoiceBlob(
  id: string, companyId: string,
  cols: ('xml_base64' | 'pdf_base64' | 'zip_base64' | 'dian_response' | 'generation_payload' | 'lineas')[] = ['dian_response']
) {
  let qb = AppDataSource.getRepository(Factura)
    .createQueryBuilder('inv')
    .leftJoinAndSelect('inv.centro_costo', 'centro_costo')
    .leftJoinAndSelect('inv.sede', 'sede')
    .leftJoinAndSelect('sede.municipio', 'sede_municipio')
    .where('inv.id = :id AND inv.company_id = :cid', { id, cid: companyId });
  cols.forEach(c => qb = qb.addSelect(`inv.${c}`));
  return qb.getOne();
}

/** Mapeo tax_type del frontend → codigo DIAN de cat_tipos_tributo */
function mapTaxType(taxType: string): string {
  const t = (taxType || '').toUpperCase();
  if (t === 'IVA')  return '01';
  if (t === 'INC')  return '04';
  if (t === 'ICA')  return '03';
  return 'ZZ';
}

/**
 * Doble escritura: persiste las líneas en factura_lineas (tabla relacional).
 * Se llama después de guardar la factura. Borra las líneas previas para
 * soportar actualizaciones idempotentes.
 */
// Hallazgo #3: acepta un EntityManager opcional (el de una transacción en curso)
// para que el borrado+recreación de líneas pueda participar en la misma
// transacción que el guardado de la factura — ver el bloque final de POST /.
// Si no se pasa ninguno, usa el manager global (comportamiento anterior, para
// los llamadores que no necesitan atomicidad extra, como PUT).
async function saveInvoiceLineas(invoiceId: string, rawLines: unknown[], manager: EntityManager = AppDataSource.manager): Promise<void> {
  if (!Array.isArray(rawLines) || rawLines.length === 0) return;
  const repo = manager.getRepository(FacturaLinea);
  // Borrar líneas previas (para PUT / re-envío)
  await repo.delete({ factura_id: invoiceId });
  const lineas = rawLines.map((l: any, idx: number) => {
    const tributo  = mapTaxType(l.tax_type ?? '');
    const esIva    = tributo === '01';
    const esInc    = tributo === '04';
    const precio   = Number(l.unit_price   ?? 0);
    const cantidad = Number(l.quantity      ?? 1);
    const dcto_pct = Number(l.discount_rate ?? 0);
    const dcto_val = Number(l.discount_amount ?? (precio * cantidad * dcto_pct / 100));
    const subtotal = precio * cantidad - dcto_val;
    const valorIva = esIva ? Number(l.tax_amount ?? 0) : 0;
    const valorInc = esInc ? Number(l.tax_amount ?? 0) : 0;
    const total    = Number(l.line_total ?? (subtotal + valorIva + valorInc));
    return repo.create({
      factura_id:           invoiceId,
      linea_numero:         idx + 1,
      descripcion:          String(l.description ?? '').substring(0, 500),
      cantidad,
      unidad_medida_codigo: String(l.unit_code ?? 'EA').substring(0, 10),
      precio_unitario:      precio,
      descuento_pct:        dcto_pct,
      descuento_valor:      dcto_val,
      subtotal,
      tipo_tributo_codigo:  tributo,
      tarifa_iva:           esIva ? Number(l.tax_rate ?? 0) : 0,
      tarifa_inc:           esInc ? Number(l.tax_rate ?? 0) : 0,
      valor_iva:            valorIva,
      valor_inc:            valorInc,
      total,
      codigo_unspsc:        l.unspsc_code ? String(l.unspsc_code).substring(0, 20) : undefined,
      cuenta_puc_codigo:    l.cuenta_puc_codigo ? String(l.cuenta_puc_codigo).substring(0, 20) : undefined,
      cuenta_puc_nombre:    l.cuenta_puc_nombre ? String(l.cuenta_puc_nombre).substring(0, 200) : undefined,
      // Hallazgo UX centro de costo/sede por línea: si el frontend no envía un
      // valor propio (línea marcada como "hereda de la factura"), queda NULL
      // y la línea hereda el centro_costo/sede de la cabecera de la factura.
      centro_costo_id:      l.centro_costo_id ? String(l.centro_costo_id) : undefined,
      sede_id:              l.sede_id ? String(l.sede_id) : undefined,
    });
  });
  await repo.save(lineas);
}


// GET /api/invoices?page=1&limit=20&status=&search=&date_from=&date_to=&export=csv
router.get('/', async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const { page = '1', limit = '20', status, search, date_from, date_to, export: exportFmt } = req.query as Record<string, string>;
    const pageNum  = +page;
    const limitNum = exportFmt === 'csv' ? 10000 : +limit; // sin paginación para export

    const qb = AppDataSource.getRepository(Factura)
      .createQueryBuilder('inv')
      .where('inv.company_id = :cid', { cid: req.user!.companyId })
      .orderBy('inv.fecha_emision', 'DESC')
      .addOrderBy('inv.created_at', 'DESC');

    if (status)    qb.andWhere('inv.estado = :status', { status });
    if (search)    qb.andWhere('(inv.cliente_nombre LIKE :q OR inv.cliente_nit LIKE :q OR inv.numero_factura LIKE :q)', { q: `%${search}%` });
    if (date_from) qb.andWhere('inv.fecha_emision >= :df', { df: date_from });
    if (date_to)   qb.andWhere('inv.fecha_emision <= :dt', { dt: date_to });

    if (exportFmt !== 'csv') {
      qb.skip((pageNum - 1) * limitNum).take(limitNum);
    }

    const [items, total] = await qb.getManyAndCount();
    res.json({ items, total, page: pageNum, limit: limitNum });
  } catch (e) {
    res.status(500).json({ error: 'Error listando facturas' });
  }
});

// GET /api/invoices/:id
router.get('/:id', async (req: AuthRequest, res: Response): Promise<void> => {
  try {
    const invoice = await findInvoiceBlob(req.params.id, req.user!.companyId, ['dian_response', 'generation_payload', 'lineas']);
    if (!invoice) { res.status(404).json({ error: 'Factura no encontrada' }); return; }
    const resp = invoice.dian_response ? (() => { try { return JSON.parse(invoice.dian_response!); } catch { return invoice.dian_response; } })() : null;
    res.json({ ...invoice, dian_response: resp });
  } catch (e) {
    res.status(500).json({ error: 'Error obteniendo factura' });
  }
});

